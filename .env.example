# ============================================================
# FinOps-SRE Sentinel — Environment Variables
# ============================================================
# Copy to .env and adjust values for your environment
# ============================================================

# --- MCP Server ---
MOCK_MODE=true
LOG_LEVEL=info

# --- UI ---
REACT_APP_API_URL=http://localhost:8080

# --- Kubernetes (production only) ---
# KUBECONFIG=/path/to/kubeconfig
# K8S_NAMESPACE=production

# --- Cloud Providers (production only) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Token Budget (production only) ---
# OPENAI_API_KEY=
# TOKEN_BUDGET_DAILY=500000
# TOKEN_BUDGET_MONTHLY=15000000